{
  "name": "dsh-plugin-feishu-im",
  "version": "1.16.0",
  "description": "DeepSeek Harness 的飞书 IM 通道：扫码创建专属飞书应用，推送任务进展与审批请求，并可在飞书中直接指挥 DSH。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "docs/screenshots",
    "README.en.md"
  ],
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "feishu",
    "lark",
    "im",
    "approval"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drliuhuan/dsh-plugin-feishu-im.git"
  },
  "homepage": "https://github.com/drliuhuan/dsh-plugin-feishu-im#readme",
  "bugs": {
    "url": "https://github.com/drliuhuan/dsh-plugin-feishu-im/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node scripts/tool-schema.mjs && node scripts/inbound-smoke.mjs && node scripts/target-smoke.mjs && node scripts/permissions-smoke.mjs && node scripts/permission-flow-smoke.mjs && node scripts/answers-smoke.mjs && node scripts/sessions-smoke.mjs && node scripts/session-card-smoke.mjs && node scripts/prefs-smoke.mjs && node scripts/service-smoke.mjs && node scripts/table-card-smoke.mjs && node scripts/render-smoke.mjs",
    "test:render": "node scripts/render-ssr.mjs",
    "test:live": "node scripts/cards-live.mjs",
    "test:timeout": "node scripts/timeout-live.mjs"
  }
}
